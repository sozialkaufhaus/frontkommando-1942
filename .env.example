# Server Port (Standard: 3001)
PORT=3001

# Verzeichnis für die persistente SQLite-Datenbank
DATA_DIR=./data

# Optional: Google OAuth 2.0 Web Client ID für "Mit Google anmelden"
# Erstellen unter https://console.cloud.google.com/apis/credentials (OAuth 2.0-Client-ID -> Webanwendung)
# Autorisierte JavaScript-Quellen: http://localhost:3001 (und deine Online-URL)
GOOGLE_CLIENT_ID=
